<section class="booking">
    <div class="container booking__container">
        <div class="booking__content">
            <h2>Бронирование</h2>
            <h3>Свяжитесь со мной, и я с удовольствием отвечу на все интересующие вас вопросы!</h3>
            <form>
                <input type="text" id="IDname" name="name" placeholder="Имя">
                <input type="date" id="IDdate" name="date" placeholder="Дата">
                <select id="IDphoto" name="photo">
                    <option value="">Тип съемки</option>
                    <option value="express">Экспресс</option>
                    <option value="full">Полный формат</option>
                    <option value="wedding">Свадебная</option>
                </select>
                <textarea id="IDmessage" name="message" placeholder="Ваше сообщение"></textarea>
                <input type="tel" id="IDtelephone" name="telephone" placeholder="Телефон">
                <button type="submit">Отравить</button>
            </form>
        </div>
    </div>
</section>
