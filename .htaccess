RewriteEngine On

# Существующие файлы и каталоги (стили, скрипты, картинки, шрифты)
# отдаём напрямую, минуя index.php
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Все остальные адреса (/personal, /price, ...) роутит index.php
RewriteRule ^ index.php [L]
